<Window x:Class="ScreenDimmer.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Screen Dimmer"
        Width="710" Height="480"
        MinWidth="660" MinHeight="440"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize">

    <Grid Margin="18,14,18,14">
        <Grid.RowDefinitions>
            <!-- Top Header & Master Toggle -->
            <RowDefinition Height="Auto" />
            <!-- Main Content 2 Columns -->
            <RowDefinition Height="*" />
            <!-- Footer Status / Shortcuts -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Header Bar -->
        <Border Grid.Row="0" Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                CornerRadius="10" Padding="14,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Title & Status -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🌙" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Screen Dimmer" FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                        <Border Margin="12,0,0,0" Padding="8,2" CornerRadius="10" VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#2D2D35" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter Property="Background" Value="#2B441B" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                        <Setter Property="Text" Value="● INACTIVE" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="Foreground" Value="#86E032" />
                                                <Setter Property="Text" Value="● ACTIVE" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                    <TextBlock Style="{StaticResource MutedText}" Margin="26,2,0,0"
                               Text="Desktop &amp; laptop display dimming with blue light reduction" />
                </StackPanel>

                <!-- Right: Master Power Toggle Button -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,10,0"
                               Text="Ctrl+Alt+D" />
                    <Button Style="{StaticResource AccentButton}"
                            Command="{Binding ToggleCommand}"
                            Content="{Binding PowerButtonText}"
                            Padding="18,7" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main 2-Column Content Grid -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- Left Column: Dimming & Laptop Brightness -->
            <StackPanel Grid.Column="0">
                <!-- Dimming Card -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,2">
                            <TextBlock Style="{StaticResource TitleText}" Text="Dim Level" />
                            <Border Style="{StaticResource ValueBadge}" HorizontalAlignment="Right">
                                <TextBlock Style="{StaticResource BadgeText}" Text="{Binding DimText}" />
                            </Border>
                        </Grid>
                        <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,6"
                                   Text="Overlays a dark transparent layer (capped safely at 78%)." />
                        <Slider Style="{StaticResource FlatSlider}" Minimum="0" Maximum="100"
                                SmallChange="1" LargeChange="5"
                                Value="{Binding Dim, Mode=TwoWay}" />

                        <!-- Preset Chips -->
                        <TextBlock Style="{StaticResource MutedText}" Margin="0,8,0,5" Text="Quick Presets:" />
                        <ItemsControl ItemsSource="{Binding Presets}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource ChipButton}"
                                            Content="{Binding Label}"
                                            Command="{Binding DataContext.ApplyPresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Extra Dim (Laptop WMI) Card -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,2">
                            <TextBlock Style="{StaticResource TitleText}" Text="Extra Dim (Laptop Panel)" />
                            <Border Style="{StaticResource ValueBadge}" HorizontalAlignment="Right"
                                    Visibility="{Binding PanelLimitEnabled, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource BadgeText}" Text="{Binding PanelLimitText}" />
                            </Border>
                        </Grid>
                        <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,5"
                                   Text="Caps hardware backlight below standard minimum via WMI. Auto-restored on exit." />
                        <TextBlock Style="{StaticResource NoteText}" Margin="0,0,0,5"
                                   Text="{Binding PanelNote}" />
                        <StackPanel IsEnabled="{Binding PanelSupported}">
                            <CheckBox Style="{StaticResource DarkCheck}" Content="Limit hardware backlight"
                                      IsChecked="{Binding PanelLimitEnabled, Mode=TwoWay}" />
                            <Slider Style="{StaticResource FlatSlider}" Margin="0,2,0,0"
                                    Minimum="0" Maximum="100" SmallChange="1" LargeChange="5"
                                    Value="{Binding PanelLimit, Mode=TwoWay}"
                                    Visibility="{Binding PanelLimitEnabled, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Right Column: Blue Light & System Preferences -->
            <StackPanel Grid.Column="2">
                <!-- Blue Light Filter Card -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,2">
                            <TextBlock Style="{StaticResource TitleText}" Text="Blue Light Filter" />
                            <Border Style="{StaticResource ValueBadge}" HorizontalAlignment="Right">
                                <TextBlock Style="{StaticResource BadgeText}" Text="{Binding TintText}" />
                            </Border>
                        </Grid>
                        <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,5"
                                   Text="Adjusts color temperature to warm amber or cool blue tones." />
                        <CheckBox Style="{StaticResource DarkCheck}" Content="Enable blue light filter"
                                  IsChecked="{Binding FilterEnabled, Mode=TwoWay}" />
                        <Slider Style="{StaticResource FlatSlider}" Margin="0,2,0,0"
                                Background="{StaticResource TintGradientBrush}"
                                Minimum="-100" Maximum="100" SmallChange="1" LargeChange="5"
                                Value="{Binding Tint, Mode=TwoWay}" />
                        <Grid Margin="2,3,2,0">
                            <TextBlock Style="{StaticResource MutedText}" Text="❄ Cool (Blue)" />
                            <TextBlock Style="{StaticResource MutedText}" HorizontalAlignment="Right" Text="🔥 Warm (Amber)" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Behavior & Hotkeys Card -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TitleText}" Text="Preferences &amp; Shortcuts" Margin="0,0,0,4" />
                        <CheckBox Style="{StaticResource DarkCheck}" Content="Start with Windows (launch to tray)"
                                  IsChecked="{Binding StartWithWindows, Mode=TwoWay}" />
                        <CheckBox Style="{StaticResource DarkCheck}" Content="Resume dimming on app start"
                                  IsChecked="{Binding ResumeOnLaunch, Mode=TwoWay}" />
                        <Border Background="#2A2A33" CornerRadius="6" Padding="10,6" Margin="0,6,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource MutedText}" Text="Toggle Dimmer:" />
                                    <TextBlock Style="{StaticResource BadgeText}" Text="Ctrl + Alt + D" Margin="0,1,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Style="{StaticResource MutedText}" Text="Dim / Tint Steps:" />
                                    <TextBlock Style="{StaticResource BadgeText}" Text="Ctrl + Alt + Arrows" Margin="0,1,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Footer Notice -->
        <TextBlock Grid.Row="2" Style="{StaticResource MutedText}" HorizontalAlignment="Center" Margin="0,4,0,0"
                   Text="Closing this window minimizes to the system tray. Use the tray menu near the clock to open or exit." />
    </Grid>
</Window>
