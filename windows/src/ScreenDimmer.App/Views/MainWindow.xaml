<Window x:Class="ScreenDimmer.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Screen Dimmer"
        Width="440" Height="820" MinHeight="560"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,16,20,24">

            <TextBlock Text="Screen Dimmer" FontSize="24" FontWeight="Bold"
                       Foreground="{StaticResource TextBrush}" />
            <TextBlock Style="{StaticResource MutedText}"
                       Text="Dim the screen and warm up the colors. Closing this window keeps it running in the tray." />

            <!-- Power -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource TitleText}" Text="{Binding StatusText}" />
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,2,0,12"
                               Text="Ctrl+Alt+D toggles it from anywhere." />
                    <Button Style="{StaticResource AccentButton}"
                            Command="{Binding ToggleCommand}"
                            Content="{Binding PowerButtonText}" />
                </StackPanel>
            </Border>

            <!-- Dimming -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <Grid>
                        <TextBlock Style="{StaticResource TitleText}" Text="Dimming" />
                        <TextBlock Style="{StaticResource BodyText}" HorizontalAlignment="Right"
                                   Text="{Binding DimText}" />
                    </Grid>
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,2,0,8"
                               Text="Maximum keeps the screen readable. It never goes fully black. Ctrl+Alt+Up/Down adjusts." />
                    <Slider Style="{StaticResource FlatSlider}" Minimum="0" Maximum="100"
                            SmallChange="1" LargeChange="5"
                            Value="{Binding Dim, Mode=TwoWay}" />
                    <ItemsControl ItemsSource="{Binding Presets}" Margin="0,10,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource ChipButton}"
                                        Content="{Binding Label}"
                                        Command="{Binding DataContext.ApplyPresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Blue light filter -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <Grid>
                        <TextBlock Style="{StaticResource TitleText}" Text="Blue light filter" />
                        <TextBlock Style="{StaticResource BodyText}" HorizontalAlignment="Right"
                                   Text="{Binding TintText}" />
                    </Grid>
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,2,0,6"
                               Text="Slide toward warm for a yellow, easy-on-the-eyes tone, or toward cool for a bluish look. Ctrl+Alt+Left/Right adjusts." />
                    <CheckBox Style="{StaticResource DarkCheck}" Content="Enable color filter"
                              IsChecked="{Binding FilterEnabled, Mode=TwoWay}" />
                    <Slider Style="{StaticResource FlatSlider}" Margin="0,4,0,0"
                            Background="{StaticResource TintGradientBrush}"
                            Minimum="-100" Maximum="100" SmallChange="1" LargeChange="5"
                            Value="{Binding Tint, Mode=TwoWay}" />
                    <Grid Margin="0,2,0,0">
                        <TextBlock Style="{StaticResource MutedText}" Text="Cool" />
                        <TextBlock Style="{StaticResource MutedText}" HorizontalAlignment="Right" Text="Warm" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Extra dim -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource TitleText}" Text="Extra dim (laptop screens)" />
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,2,0,6"
                               Text="Also caps the panel's own brightness so the screen can go darker than the Windows minimum. The original brightness is restored when you turn the dimmer off or exit." />
                    <TextBlock Style="{StaticResource NoteText}" Margin="0,0,0,6"
                               Text="{Binding PanelNote}" />
                    <StackPanel IsEnabled="{Binding PanelSupported}">
                        <CheckBox Style="{StaticResource DarkCheck}" Content="Limit panel brightness"
                                  IsChecked="{Binding PanelLimitEnabled, Mode=TwoWay}" />
                        <StackPanel Visibility="{Binding PanelLimitEnabled, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <TextBlock Style="{StaticResource BodyText}" Text="Panel brightness" />
                                <TextBlock Style="{StaticResource BodyText}" HorizontalAlignment="Right"
                                           Text="{Binding PanelLimitText}" />
                            </Grid>
                            <Slider Style="{StaticResource FlatSlider}" Minimum="0" Maximum="100"
                                    SmallChange="1" LargeChange="5"
                                    Value="{Binding PanelLimit, Mode=TwoWay}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Behavior -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource TitleText}" Text="Behavior" Margin="0,0,0,4" />
                    <CheckBox Style="{StaticResource DarkCheck}" Content="Start with Windows (in the tray)"
                              IsChecked="{Binding StartWithWindows, Mode=TwoWay}" />
                    <CheckBox Style="{StaticResource DarkCheck}" Content="Resume dimming when the app starts"
                              IsChecked="{Binding ResumeOnLaunch, Mode=TwoWay}" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Window>
